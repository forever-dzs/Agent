APP_ENV=development
APP_NAME=enterprise-knowledge-chat
LOG_LEVEL=INFO

# Backend runtime
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Feishu knowledge base
FEISHU_APP_ID=cli_a1234567890abcdef
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_KNOWLEDGE_BASE_URL=https://open.feishu.cn/open-apis/drive/explorer/v2
FEISHU_KNOWLEDGE_ROOT_TOKEN=your_feishu_root_folder_token
FEISHU_TOKEN=your_feishu_access_token

# LLM providers
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_ROUTER_MODEL=gpt-4o-mini
LLM_SUMMARY_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=enterprise_knowledge
MILVUS_DIMENSION=1536

# Retrieval and caching
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.15
CACHE_TTL_SECONDS=1800
CACHE_MAX_ENTRIES=500
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
